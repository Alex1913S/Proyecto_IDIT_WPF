<UserControl x:Class="Presentación.Controls.NotificacionModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ModalButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseXStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="13">
                            <TextBlock Text="✕" FontSize="14" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Overlay de fondo -->
    <Grid x:Name="RootOverlay" Background="#66000000" MouseLeftButtonDown="Overlay_MouseDown">

        <!-- Tarjeta -->
        <Border x:Name="CardBorder"
                Width="360"
                Background="White"
                CornerRadius="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ClipToBounds="True"
                MouseLeftButtonDown="Card_MouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="35" ShadowDepth="10" Opacity="0.35" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabecera de color -->
                <Border x:Name="HeaderBorder" Grid.Row="0" Padding="0,32,0,28">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtTitulo"
                                       Text="Éxito"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>

                            <Border x:Name="IconCircle"
                                    Width="56" Height="56"
                                    Background="#33FFFFFF"
                                    CornerRadius="28"
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Center">
                                <Path x:Name="IconPath"
                                      Fill="White"
                                      Width="26" Height="26"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <Button x:Name="BtnCerrarX"
                                Style="{StaticResource CloseXStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,14,14,0"
                                Click="BtnCerrar_Click"/>
                    </Grid>
                </Border>

                <!-- Cuerpo -->
                <StackPanel Grid.Row="1" Margin="30,26,30,28">
                    <TextBlock x:Name="TxtMensaje"
                               Text="Tu archivo ha sido cargado."
                               FontSize="14"
                               Foreground="#475569"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,22"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnAccion"
                                Content="Entendido"
                                Style="{StaticResource ModalButtonStyle}"
                                HorizontalAlignment="Center"
                                MinWidth="120"
                                Margin="0,0,8,0"
                                Click="BtnAccion_Click"/>

                        <Button x:Name="BtnCancelar"
                                Content="Cancelar"
                                Style="{StaticResource ModalButtonStyle}"
                                HorizontalAlignment="Center"
                                MinWidth="120"
                                Margin="8,0,0,0"
                                Visibility="Collapsed"
                                Click="BtnCancelar_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>