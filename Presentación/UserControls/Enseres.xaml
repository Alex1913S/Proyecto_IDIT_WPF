<UserControl x:Class="Presentación.UserControls.Enseres"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100"
             Background="Transparent"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="ModernInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#0d3a5c"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1a4a7a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#2F80ED"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#2F80ED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="ModernComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0d3a5c"/>
            <Setter Property="BorderBrush" Value="#1a4a7a"/>
            <Setter Property="Padding" Value="10,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="46"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0C4E0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#0e3560"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CenterCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#0d3a5c"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0D0D2D"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1a4a7a"/>
                    <Setter Property="Foreground" Value="#2F80ED"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#5a8ab0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid Margin="15,10,15,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ PANEL LATERAL ══ -->
            <Border x:Name="PanelLateralBorder" Grid.Column="0" Background="#09274c" CornerRadius="12"
                    BorderBrush="#0d3a5c" BorderThickness="1" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="📦 Inventario de Enseres" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Mobiliario, equipos menores y suministros de oficina"
                                   FontSize="10" Foreground="#A0C4E0" TextWrapping="Wrap" Margin="0,4,0,16"/>

                        <Border Background="#071d34" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="TOTAL EN INVENTARIO" FontSize="9" FontWeight="Bold" Foreground="#2F80ED"/>
                                <TextBlock x:Name="TxtTotalEnseres" Text="0 unidades" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="TxtFormTitulo" Text="Nuevo Enser" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>

                        <TextBlock Text="Nombre *" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtNombre" Style="{StaticResource ModernInputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="Categoría" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CbCategoria" Style="{StaticResource ModernComboStyle}" IsEditable="True" Margin="0,0,0,10">
                            <ComboBoxItem Content="Mobiliario"/>
                            <ComboBoxItem Content="Electrodoméstico"/>
                            <ComboBoxItem Content="Utensilio de Oficina"/>
                            <ComboBoxItem Content="Herramienta"/>
                            <ComboBoxItem Content="Decoración"/>
                            <ComboBoxItem Content="Otro"/>
                        </ComboBox>

                        <TextBlock Text="Ubicación" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CbUbicacion" Style="{StaticResource ModernComboStyle}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cantidad *" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtCantidad" Text="1" Style="{StaticResource ModernInputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="N° Inventario" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtNumInventario" Style="{StaticResource ModernInputStyle}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Estado Físico *" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CbEstado" Style="{StaticResource ModernComboStyle}" Margin="0,0,0,10">
                            <ComboBoxItem Content="Bueno" IsSelected="True"/>
                            <ComboBoxItem Content="Regular"/>
                            <ComboBoxItem Content="Malo"/>
                            <ComboBoxItem Content="De Baja"/>
                        </ComboBox>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Fecha Adquisición" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker x:Name="DpFecha" Height="36"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Costo ($)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtCosto" Style="{StaticResource ModernInputStyle}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Observaciones" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtObservaciones" Style="{StaticResource ModernInputStyle}"
                                 Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" Padding="10,8" Margin="0,0,0,16"/>

                        <Button x:Name="BtnGuardar" Content="Guardar Enser"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#2F80ED" Foreground="#08213a"
                                Margin="0,0,0,8" Click="BtnGuardar_Click"/>
                        <Button x:Name="BtnCancelarEdicion" Content="Cancelar Edición"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#151538" Foreground="#A0A0B8"
                                Visibility="Collapsed"
                                Click="BtnCancelarEdicion_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ══ ÁREA PRINCIPAL ══ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Listado de Enseres" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <Border Width="260" Height="36" Background="#09274c" BorderBrush="#0d3a5c" BorderThickness="1"
                            CornerRadius="6" HorizontalAlignment="Right">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" Foreground="#A0C4E0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                            <TextBox x:Name="TxtBuscar" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Foreground="White" VerticalContentAlignment="Center" FontSize="13"
                                     CaretBrush="#2F80ED" TextChanged="TxtBuscar_TextChanged"/>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Background="#09274c" CornerRadius="8" BorderBrush="#0d3a5c" BorderThickness="1" Padding="10">
                    <DataGrid x:Name="DgEnseres" Style="{StaticResource ModernDataGridStyle}"
                              SelectionChanged="DgEnseres_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="1.6*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2F80ED"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding CategoriaEnser}" Width="1.2*" ElementStyle="{StaticResource CenterCellStyle}"/>
                            <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="1.2*" ElementStyle="{StaticResource CenterCellStyle}"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="0.8*" ElementStyle="{StaticResource CenterCellStyle}"/>
                            <DataGridTextColumn Header="N° Inventario" Binding="{Binding NumeroInventario}" Width="1*" ElementStyle="{StaticResource CenterCellStyle}"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding EstadoFisico}" Width="0.9*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="Bueno">
                                                <Setter Property="Foreground" Value="#4CD964"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="Regular">
                                                <Setter Property="Foreground" Value="#FF9500"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="Malo">
                                                <Setter Property="Foreground" Value="#e7133f"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="De Baja">
                                                <Setter Property="Foreground" Value="#A0A0B8"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Costo" Binding="{Binding Costo, StringFormat='{}{0:C}'}" Width="1*" ElementStyle="{StaticResource CenterCellStyle}"/>
                            <DataGridTemplateColumn Header="Acciones" Width="0.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="✏" Width="26" Height="26" Margin="2,0"
                                                    Background="Transparent" Foreground="#2F80ED" BorderThickness="0"
                                                    Cursor="Hand" Click="BtnEditarFila_Click"/>
                                            <Button Content="🗑" Width="26" Height="26" Margin="2,0"
                                                    Background="Transparent" Foreground="#e7133f" BorderThickness="0"
                                                    Cursor="Hand" Click="BtnEliminarFila_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>