<UserControl x:Class="Presentación.UserControls.MantenimientoTI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="Transparent"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>

        <!-- ══ TAB FILTER ══ -->
        <Style x:Key="TabFilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0C4E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Border x:Name="Badge" Margin="8,0,0,0" Background="#09274c"
                                        CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="BadgeText"
                                               Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                               FontSize="11" Foreground="#A0A0B8" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#1a4a7a"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#2F80ED"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2F80ED"/>
                                <Setter TargetName="BadgeText" Property="Foreground" Value="#2F80ED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ DATAGRID ══ -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="48"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0C4E0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#0e3560"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CenterCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#0d3a5c"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0D0D2D"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1a4a7a"/>
                    <Setter Property="Foreground" Value="#2F80ED"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══ INPUT / COMBO ══ -->
        <Style x:Key="ModernInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#0d3a5c"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1a4a7a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#2F80ED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="ModernComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0d3a5c"/>
            <Setter Property="BorderBrush" Value="#1a4a7a"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ══ ACTION BUTTON ══ -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#5a8ab0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid Margin="15,10,15,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══ HEADER + KPIs ══ -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Mantenimiento TI" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Trazabilidad completa de equipos en soporte técnico"
                               FontSize="12" Foreground="#A0C4E0" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Width="230" Height="34" Background="#09274c" BorderBrush="#0d3a5c"
                            BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" Foreground="#A0C4E0" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" FontSize="12"/>
                            <TextBox x:Name="TxtBuscar" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Foreground="White" VerticalContentAlignment="Center" FontSize="12"
                                     CaretBrush="#2F80ED" TextChanged="TxtBuscar_TextChanged"/>
                        </Grid>
                    </Border>
                    <Button x:Name="BtnNuevo" Content="+ Ingresar a Mantenimiento" Width="190" Height="34"
                            Background="#2F80ED" Foreground="#08213a" FontWeight="Bold" BorderThickness="0"
                            Cursor="Hand" Click="BtnNuevo_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- KPIs -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                <Border Background="#09274c" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Total Registros" FontSize="11" Foreground="#A0A0B8"/>
                        <TextBlock x:Name="TxtKpiTotal" Text="0" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#09274c" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Abiertos" FontSize="11" Foreground="#A0A0B8"/>
                        <TextBlock x:Name="TxtKpiAbiertos" Text="0" FontSize="20" FontWeight="Bold" Foreground="#FF9500" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#09274c" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Vencidos (SLA)" FontSize="11" Foreground="#A0A0B8"/>
                        <TextBlock x:Name="TxtKpiVencidos" Text="0" FontSize="20" FontWeight="Bold" Foreground="#e7133f" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#09274c" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Promedio días resolución" FontSize="11" Foreground="#A0A0B8"/>
                        <TextBlock x:Name="TxtKpiPromedio" Text="0" FontSize="20" FontWeight="Bold" Foreground="#4CD964" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Tabs de estado -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="BtnTabTodos" Content="Todos" Style="{StaticResource TabFilterButtonStyle}"
                        IsEnabled="False" Click="FilterTab_Click"/>
                <Button x:Name="BtnTabAbierto" Content="Abierto" Style="{StaticResource TabFilterButtonStyle}" Click="FilterTab_Click"/>
                <Button x:Name="BtnTabProceso" Content="En Proceso" Style="{StaticResource TabFilterButtonStyle}" Click="FilterTab_Click"/>
                <Button x:Name="BtnTabRepuesto" Content="Esperando Repuesto" Style="{StaticResource TabFilterButtonStyle}" Click="FilterTab_Click"/>
                <Button x:Name="BtnTabCerrado" Content="Cerrado" Style="{StaticResource TabFilterButtonStyle}" Click="FilterTab_Click"/>
            </StackPanel>

            <!-- ══ CUERPO: Grid + Panel de detalle ══ -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#09274c" CornerRadius="8" BorderBrush="#0d3a5c" BorderThickness="1" Padding="10">
                    <DataGrid x:Name="DgMantenimientos" Style="{StaticResource ModernDataGridStyle}"
                              SelectionChanged="DgMantenimientos_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Equipo" Binding="{Binding EquipoNombre}" Width="1.4*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2F80ED"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TipoMantenimiento}" Width="1*" ElementStyle="{StaticResource CenterCellStyle}"/>
                            <DataGridTextColumn Header="Prioridad" Binding="{Binding Prioridad}" Width="0.9*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="Crítica">
                                                <Setter Property="Foreground" Value="#e7133f"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="Alta">
                                                <Setter Property="Foreground" Value="#FF9500"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="Media">
                                                <Setter Property="Foreground" Value="#34AADC"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="Baja">
                                                <Setter Property="Foreground" Value="#A0C4E0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="1.2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="Abierto">
                                                <Setter Property="Foreground" Value="#FF9500"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="En Proceso">
                                                <Setter Property="Foreground" Value="#34AADC"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="Esperando Repuesto">
                                                <Setter Property="Foreground" Value="#e7133f"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="Cerrado">
                                                <Setter Property="Foreground" Value="#4CD964"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Responsable" Binding="{Binding Responsable}" Width="1.2*" ElementStyle="{StaticResource CenterCellStyle}"/>
                            <DataGridTextColumn Header="Ingreso" Binding="{Binding FechaIngreso, StringFormat=dd/MM/yyyy}" Width="1*" ElementStyle="{StaticResource CenterCellStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Panel de detalle: tabs Info / Historial / Fotos -->
                <Border Grid.Column="2" Background="#09274c" CornerRadius="8" BorderBrush="#0d3a5c" BorderThickness="1" Padding="14">
                    <Grid>
                        <StackPanel x:Name="PanelSinSeleccion" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🛠" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Selecciona un registro" FontSize="14" Foreground="#A0C4E0" TextAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer x:Name="PanelDetalle" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="TxtDetEquipo" Text="—" FontSize="15" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtDetEstado" Text="—" FontSize="12" Foreground="#FF9500" FontWeight="SemiBold" Margin="0,4,0,10"/>

                                <TextBlock Text="Descripción" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock x:Name="TxtDetDescripcion" Text="—" FontSize="12" Foreground="#A0C4E0" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <TextBlock Text="Diagnóstico técnico" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock x:Name="TxtDetDiagnostico" Text="—" FontSize="12" Foreground="#A0C4E0" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Costo" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock x:Name="TxtDetCosto" Text="—" FontSize="13" Foreground="White"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Garantía" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock x:Name="TxtDetGarantia" Text="—" FontSize="13" Foreground="White"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Cambio de estado -->
                                <Border Background="#071d34" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="CAMBIAR ESTADO" FontSize="10" FontWeight="Bold" Foreground="#2F80ED" Margin="0,0,0,8"/>
                                        <ComboBox x:Name="CbNuevoEstado" Style="{StaticResource ModernComboStyle}" Margin="0,0,0,8">
                                            <ComboBoxItem Content="Abierto"/>
                                            <ComboBoxItem Content="En Proceso"/>
                                            <ComboBoxItem Content="Esperando Repuesto"/>
                                            <ComboBoxItem Content="Cerrado"/>
                                            <ComboBoxItem Content="Cancelado"/>
                                        </ComboBox>
                                        <TextBox x:Name="TxtComentarioCambio" Style="{StaticResource ModernInputStyle}"
                                                 Height="50" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                                 Padding="8,6" Margin="0,0,0,8"
                                                 Tag="Comentario del cambio (obligatorio)"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtCostoFinal" Grid.Column="0" Style="{StaticResource ModernInputStyle}"/>
                                            <CheckBox x:Name="ChkGarantia" Grid.Column="2" Content="Garantía aplicada"
                                                      Foreground="#A0C4E0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Button x:Name="BtnActualizarEstado" Content="Actualizar Estado"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Background="#2F80ED" Foreground="#08213a"
                                                Click="BtnActualizarEstado_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Fotos -->
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="EVIDENCIA FOTOGRÁFICA" FontSize="10" FontWeight="Bold" Foreground="#2F80ED"/>
                                    <Button x:Name="BtnAdjuntarFoto" Content="+ Adjuntar foto" HorizontalAlignment="Right"
                                            Height="24" Padding="10,0" FontSize="10" Background="#0d3a5c" Foreground="#A0C4E0"
                                            BorderThickness="0" Cursor="Hand" Click="BtnAdjuntarFoto_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <ItemsControl x:Name="IcFotos" Margin="0,8,0,14">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="90" Height="90" Margin="0,0,8,8" CornerRadius="6"
                                                    Background="#071d34" ClipToBounds="True" BorderBrush="#1a4a7a" BorderThickness="1">
                                                <Image Source="{Binding Imagen}" Stretch="UniformToFill" ToolTip="{Binding Descripcion}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Historial (timeline) -->
                                <TextBlock Text="HISTORIAL DE CAMBIOS" FontSize="10" FontWeight="Bold" Foreground="#2F80ED" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="IcHistorial">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="#2F80ED" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="White">
                                                        <Run Text="{Binding EstadoAnterior}"/>
                                                        <Run Text=" → "/>
                                                        <Run Text="{Binding EstadoNuevo}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Comentario}" FontSize="11" Foreground="#A0C4E0" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    <TextBlock FontSize="10" Foreground="#5a8ab0" Margin="0,2,0,0">
                                                        <Run Text="{Binding AutorCambio}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding FechaCambio, StringFormat='dd/MM/yyyy HH:mm'}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Formulario nuevo mantenimiento -->
                        <ScrollViewer x:Name="PanelFormulario" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Nuevo Ingreso a Mantenimiento" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,14"/>

                                <TextBlock Text="Activo *" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="CbActivo" Style="{StaticResource ModernComboStyle}" Margin="0,0,0,10"/>

                                <TextBlock Text="Tipo de mantenimiento *" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="CbTipo" Style="{StaticResource ModernComboStyle}" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Preventivo"/>
                                    <ComboBoxItem Content="Correctivo"/>
                                    <ComboBoxItem Content="Garantía"/>
                                    <ComboBoxItem Content="Actualización"/>
                                </ComboBox>

                                <TextBlock Text="Prioridad *" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="CbPrioridad" Style="{StaticResource ModernComboStyle}" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Baja"/>
                                    <ComboBoxItem Content="Media" IsSelected="True"/>
                                    <ComboBoxItem Content="Alta"/>
                                    <ComboBoxItem Content="Crítica"/>
                                </ComboBox>

                                <TextBlock Text="Responsable" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="CbResponsable" Style="{StaticResource ModernComboStyle}" Margin="0,0,0,10"/>

                                <TextBlock Text="Fecha estimada de entrega" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker x:Name="DpFechaEstimada" Height="34" Margin="0,0,0,10"/>

                                <TextBlock Text="Descripción del problema *" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtDescripcion" Style="{StaticResource ModernInputStyle}"
                                         Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top" Padding="8,6" Margin="0,0,0,16"/>

                                <Button x:Name="BtnGuardarMantenimiento" Content="Registrar Ingreso"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Background="#2F80ED" Foreground="#08213a"
                                        Margin="0,0,0,8" Click="BtnGuardarMantenimiento_Click"/>
                                <Button x:Name="BtnCancelarForm" Content="Cancelar"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Background="#0d3a5c" Foreground="#A0C4E0"
                                        Click="BtnCancelarForm_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
