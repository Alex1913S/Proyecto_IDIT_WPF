<UserControl x:Class="Presentación.View_Create_Assets"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="900"
             Background="Transparent">

    <UserControl.Resources>
        <!-- 1. Estilo para limpiar la caja de texto interna y el fondo blanco -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Grid>
                            <TextBox x:Name="PART_TextBox"
                             Text="{Binding Path=Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                             Background="Transparent"
                             Foreground="White"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Padding="8,0"/>
                            <!-- Texto de ayuda cuando está vacío -->
                            <TextBlock x:Name="Watermark"
                               Text="Selecciona una fecha"
                               Foreground="#A0A0B8"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=PART_TextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=PART_TextBox}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 2. Estilo principal del DatePicker (Bordes, Colores e Ícono Moderno) -->
        <Style TargetType="DatePicker">
            <!-- Colores base aproximados a tu diseño -->
            <Setter Property="Background" Value="#0b2848"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#235282"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CalendarStyle" Value="{DynamicResource MyCalendarStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                            <!-- Mismo radio de tus otros inputs -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Caja de texto integrada -->
                                <DatePickerTextBox x:Name="PART_TextBox"
                                           Grid.Column="0"
                                           HorizontalContentAlignment="Stretch"
                                           VerticalContentAlignment="Center"
                                           Focusable="True" />

                                <!-- Nuevo botón del calendario -->
                                <Button x:Name="PART_Button"
                                Grid.Column="1"
                                Width="30"
                                Focusable="False"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                                    <!-- Ícono SVG vectorizado y limpio -->
                                    <Path Data="M19,4H18V2H16V4H8V2H6V4H5C3.89,4 3.01,4.9 3.01,6L3,20C3,21.1 3.89,22 5,22H19C20.1,22 21,21.1 21,20V6C21,4.9 20.1,4 19,4ZM19,20H5V10H19V20ZM19,8H5V6H19V8ZM9,14H7V12H9V14ZM13,14H11V12H13V14ZM17,14H15V12H17V14ZM9,18H7V16H9V18ZM13,18H11V16H13V18ZM17,18H15V16H17V18Z"
                                  Fill="#A0A0B8"
                                  Stretch="Uniform"
                                  Margin="6,5"/>
                                </Button>

                                <!-- Panel desplegable nativo -->
                                <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=PART_TextBox}"
                               StaysOpen="False"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Botón de flecha (‹ ›) circular ══ -->
        <Style x:Key="CalendarArrowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#F1F3F6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E4E7EC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MyCalendarButtonStyle" TargetType="CalendarButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F3F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Botón de cada día del mes ══ -->
        <Style x:Key="MyCalendarDayButtonStyle" TargetType="CalendarDayButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="19" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EAF2FE"/>
                            </Trigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#2F80ED"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2F80ED"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsBlackedOut" Value="True">
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Nombres de los días de la semana (Su Mo Tu We Th Fr Sa) ══ -->
        <Style TargetType="TextBlock"
       x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type Calendar}, ResourceId=CalendarDayTitleStyle}">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ══ CalendarItem: la "tarjeta" completa (header + grilla de días) ══ -->
        <Style TargetType="{x:Type CalendarItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CalendarItem}">
                        <Border Background="White" CornerRadius="18" Padding="18,16,18,14" BorderThickness="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header: ‹  Noviembre 2023  › -->
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="PART_PreviousButton" Grid.Column="0"
                                    Style="{StaticResource CalendarArrowButtonStyle}">
                                        <Path Data="M15,18 L9,12 L15,6" Stroke="#334155" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Width="10" Height="12" Stretch="Uniform"/>
                                    </Button>

                                    <Button x:Name="PART_HeaderButton" Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#1E293B" FontSize="16" FontWeight="Bold"
                                    Cursor="Hand" Focusable="False">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button x:Name="PART_NextButton" Grid.Column="2"
                                    Style="{StaticResource CalendarArrowButtonStyle}">
                                        <Path Data="M9,6 L15,12 L9,18" Stroke="#334155" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Width="10" Height="12" Stretch="Uniform"/>
                                    </Button>
                                </Grid>

                                <!-- Vista de mes (días) y vista de año/década (para navegar rápido) -->
                                <Grid Grid.Row="1">
                                    <Grid x:Name="PART_MonthView" HorizontalAlignment="Center"/>
                                    <Grid x:Name="PART_YearView" HorizontalAlignment="Center" Visibility="Hidden"/>
                                </Grid>

                                <!-- Elemento requerido por el contrato del template, aunque no se use -->
                                <Rectangle x:Name="PART_DisabledVisual" Grid.RowSpan="2"
                                   Fill="#80FFFFFF" Visibility="Collapsed" RadiusX="18" RadiusY="18"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Estilo del Calendar (solo conecta los estilos de arriba) ══ -->
        <Style x:Key="MyCalendarStyle" TargetType="Calendar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CalendarButtonStyle" Value="{StaticResource MyCalendarButtonStyle}"/>
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource MyCalendarDayButtonStyle}"/>
        </Style>

        
        <!-- Estilo para la caja de texto interna -->
        <Style x:Key="DatePickerTextBoxStyle" TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <TextBox x:Name="PART_TextBox"
                             Text="{Binding Path=Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                             Background="Transparent"
                             Foreground="White"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Padding="8,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

       

        <!-- Estilo principal del DatePicker -->
        <Style x:Key="MyDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Background" Value="#0b2848"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#235282"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CalendarStyle" Value="{StaticResource MyCalendarStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" Style="{StaticResource DatePickerTextBoxStyle}"/>
                                <Button x:Name="PART_Button" Grid.Column="1" Width="30" Background="Transparent" BorderThickness="0" Focusable="False">
                                    <Path Data="M19,4H18V2H16V4H8V2H6V4H5C3.89,4 3.01,4.9 3.01,6L3,20C3,21.1 3.89,22 5,22H19C20.1,22 21,21.1 21,20V6C21,4.9 20.1,4 19,4ZM19,20H5V10H19V20ZM19,8H5V6H19V8ZM9,14H7V12H9V14ZM13,14H11V12H13V14ZM17,14H15V12H17V14ZM9,18H7V16H9V18ZM13,18H11V16H13V18ZM17,18H15V16H17V18Z" Fill="#A0A0B8" Stretch="Uniform" Margin="6,5"/>
                                </Button>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#09274c"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#061e35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#2F80ED"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BaseBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BaseBorder" Property="BorderBrush" Value="#2F80ED"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="BaseBorder" Property="BorderBrush" Value="#2F80ED"/>
                                <Setter TargetName="BaseBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2F80ED"/>
                                <Setter Property="Foreground" Value="#060621"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3F3F6B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="ToggleButtonBorder" 
                    Background="#09274c" 
                    BorderBrush="#061e35" 
                    BorderThickness="1" 
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow" 
                          Grid.Column="1" 
                          Fill="#A0A0B8" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center" 
                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="ToggleButtonBorder" Property="BorderBrush" Value="#2F80ED"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#2F80ED"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="ToggleButtonBorder" Property="BorderBrush" Value="#2F80ED"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        
        

        <Style x:Key="ModernComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0d3a5c"/>
            <Setter Property="BorderBrush" Value="#09274c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>

                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left">
                            </ContentPresenter>

                            <Popup x:Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#09274c" 
                                            BorderBrush="#2F80ED" 
                                            BorderThickness="1" 
                                            CornerRadius="6"
                                            Margin="0,3,0,0">
                                        <ScrollViewer Margin="0,2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        
    </UserControl.Resources>
    
    

    <Grid Margin="10,5,10,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel x:Name="Step1Indicator" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="CircleStep1" Width="28" Height="28" Background="#2F80ED" CornerRadius="14">
                        <TextBlock Text="1" Foreground="#060621" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStep1Title" Text="Información Base" FontSize="13" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Datos generales del activo" FontSize="10" Foreground="#A0A0B8"/>
                    </StackPanel>
                </StackPanel>

                <Rectangle x:Name="LineConnector" Width="80" Height="2" Fill="#A0A0B8" Margin="20,0,20,0" VerticalAlignment="Center"/>

                <StackPanel x:Name="Step2Indicator" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.5">
                    <Border x:Name="CircleStep2" Width="28" Height="28" Background="#2160a5" CornerRadius="14" BorderBrush="#060621" BorderThickness="1">
                        <TextBlock x:Name="TxtNum2" Text="2" Foreground="#060621" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStep2Title" Text="Detalles de Hardware" FontSize="13" FontWeight="Bold" Foreground="#A0A0B8"/>
                        <TextBlock Text="Especificaciones técnicas" FontSize="10" Foreground="#A0A0B8"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <TabControl x:Name="WizardTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="10,0,10,0" VerticalAlignment="Top">

                        <StackPanel Margin="15,8,15,8">
                            <TextBlock x:Name="L1" Text="Categoría" Foreground="#A0C4E0" FontWeight="Medium" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CbCategoria" Style="{StaticResource ModernComboStyle}"/>
                        </StackPanel>

                        <StackPanel Margin="15,8,15,8">
                            <TextBlock x:Name="L2" Text="Estado Operativo" Foreground="#A0C4E0" FontWeight="Medium" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CbEstado" Style="{StaticResource ModernComboStyle}">
                                <ComboBoxItem Content="En Bodega" IsSelected="True"/>
                                <ComboBoxItem Content="Asignado"/>
                                <ComboBoxItem Content="En Mantenimiento"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="15,8,15,8">
                            <TextBlock x:Name="L3" Text="Ubicación" Foreground="#A0C4E0" FontWeight="Medium" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CbUbicacion" Style="{StaticResource ModernComboStyle}"/>
                        </StackPanel>

                        <StackPanel Margin="15,8,15,8">
                            <TextBlock x:Name="L4" Text="Fecha de Registro" Foreground="#A0C4E0" FontWeight="Medium" Margin="0,0,0,6"/>
                            <DatePicker x:Name="DpFecha" Height="38" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Margin="15,8,15,8">
                            <TextBlock x:Name="L5" Text="Proveedor" Foreground="#A0C4E0" FontWeight="Medium" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CbProveedor" Style="{StaticResource ModernComboStyle}"/>
                        </StackPanel>

                        <StackPanel Margin="15,8,15,8">
                            <TextBlock x:Name="L6" Text="Costo de Activo ($)" Foreground="#A0C4E0" FontWeight="Medium" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtCosto" Style="{StaticResource ModernInputStyle}"/>
                        </StackPanel>
                        <!-- Agregar dentro del UniformGrid del TabItem Paso 1 -->
                        <StackPanel Margin="15,8,15,8" Grid.ColumnSpan="2">
                            <TextBlock Text="Factura de Compra (PDF)" Foreground="#A0C4E0" FontWeight="Medium" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Nombre del archivo seleccionado -->
                                <Border Grid.Column="0" Background="#09274c" BorderBrush="#061e35" BorderThickness="1" CornerRadius="6,0,0,6" Height="38">
                                    <TextBlock x:Name="TxtNombreFactura"
                                                   Text="Ningún archivo seleccionado"
                                                   Foreground="#A0A0B8" FontSize="12"
                                                   VerticalAlignment="Center" Margin="10,0"/>
                                </Border>

                                <!-- Botón seleccionar PDF -->
                                <Button x:Name="BtnSeleccionarPdf" Grid.Column="1"
                                            Content="Seleccionar PDF"
                                            Height="38" Padding="12,0"
                                            Background="#2F80ED" Foreground="#060621"
                                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                            Click="BtnSeleccionarPdf_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"  CornerRadius="0,6,6,0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Botón ver PDF (solo si hay uno cargado) -->
                                <Button x:Name="BtnVerPdf" Grid.Column="2"
                                            Content="Ver PDF"
                                            Height="38" Padding="12,0"
                                            Background="#151538" Foreground="#A0C4E0"
                                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                            Visibility="Collapsed"
                                            Click="BtnVerPdf_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="0,6,6,0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Badge de tamaño del archivo -->
                            <TextBlock x:Name="TxtTamañoPdf"
                                       FontSize="11" Foreground="#5a8ab0"
                                       Margin="0,4,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="10,0,10,0">
                        <StackPanel Margin="15,6,15,6">
                            <TextBlock x:Name="LH1" Text="Marca" Foreground="#A0C4E0" FontWeight="Medium" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtMarca" Style="{StaticResource ModernInputStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="15,6,15,6">
                            <TextBlock x:Name="LH2" Text="Tarjeta Gráfica" Foreground="#A0C4E0" FontWeight="Medium" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtGrafica" Style="{StaticResource ModernInputStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="15,6,15,6">
                            <TextBlock x:Name="LH3" Text="Modelo" Foreground="#A0C4E0" FontWeight="Medium" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtModelo" Style="{StaticResource ModernInputStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="15,6,15,6">
                            <TextBlock x:Name="LH4" Text="Memoria RAM" Foreground="#A0C4E0" FontWeight="Medium" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtRam" Style="{StaticResource ModernInputStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="15,6,15,6">
                            <TextBlock x:Name="LH5" Text="Número de Serie" Foreground="#A0C4E0" FontWeight="Medium" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtSerie" Style="{StaticResource ModernInputStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="15,6,15,6">
                            <TextBlock x:Name="LH6" Text="Almacenamiento [1]" Foreground="#A0C4E0" FontWeight="Medium" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtDisco1" Style="{StaticResource ModernInputStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="15,6,15,6">
                            <TextBlock x:Name="LH7" Text="Dirección MAC" Foreground="#A0C4E0" FontWeight="Medium" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtMac" Style="{StaticResource ModernInputStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="15,6,15,6">
                            <TextBlock x:Name="LH8" Text="Almacenamiento [2]" Foreground="#A0C4E0" FontWeight="Medium" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtDisco2" Style="{StaticResource ModernInputStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="15,6,15,6">
                            <TextBlock x:Name="LH9" Text="Dirección IP" Foreground="#A0C4E0" FontWeight="Medium" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtIp" Style="{StaticResource ModernInputStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="15,6,15,6">
                            <TextBlock x:Name="LH10" Text="Sistema Operativo" Foreground="#A0C4E0" FontWeight="Medium" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtSo" Style="{StaticResource ModernInputStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="15,6,15,6">
                            <TextBlock x:Name="LH11" Text="Procesador" Foreground="#A0C4E0" FontWeight="Medium" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtProcesador" Style="{StaticResource ModernInputStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="15,6,15,6">
                            <TextBlock x:Name="LH12" Text="Resolución de Pantalla" Foreground="#A0C4E0" FontWeight="Medium" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtResolucion" Style="{StaticResource ModernInputStyle}"/>
                        </StackPanel>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="15,10,15,0">
            <Button x:Name="BtnCancelar" Content="Cancelar Registro" HorizontalAlignment="Left" Width="140" Height="38" Background="#e7133f" Foreground="#890927" BorderBrush="#890927" FontWeight="Bold" BorderThickness="1" Cursor="Hand" Click="BtnCancelar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSiguiente" Content="Siguiente" Width="120" Height="38" Background="#2F80ED" Foreground="#060621" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSiguiente_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnAtras" Content="Anterior" Width="100" Height="38" Background="#151538" Foreground="White" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Visibility="Collapsed" Click="BtnAtras_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>