<UserControl x:Class="Presentación.See_Assets"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             HorizontalAlignment="Stretch" 
             VerticalAlignment="Stretch"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="ScrollBarLineButton" TargetType="RepeatButton">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Border" CornerRadius="4" Background="#0d3a5c" Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2F80ED" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2F80ED" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="#09274c">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <RepeatButton Grid.Row="0" Style="{StaticResource ScrollBarLineButton}" Command="ScrollBar.LineUpCommand"/>
                                    <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                    <RepeatButton Grid.Row="2" Style="{StaticResource ScrollBarLineButton}" Command="ScrollBar.LineDownCommand"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="#09274c">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <RepeatButton Grid.Column="0" Style="{StaticResource ScrollBarLineButton}" Command="ScrollBar.LineLeftCommand"/>
                                    <Track x:Name="PART_Track" Grid.Column="1" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                    <RepeatButton Grid.Column="2" Style="{StaticResource ScrollBarLineButton}" Command="ScrollBar.LineRightCommand"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabFilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A0B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Border x:Name="Badge" Margin="8,0,0,0" Background="#09274c" CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="BadgeText" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="11" Foreground="#A0A0B8" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0d3a5c"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#2F80ED"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2F80ED"/>
                                <Setter TargetName="BadgeText" Property="Foreground" Value="#2F80ED"/>
                                <Setter TargetName="Badge" Property="Background" Value="#1b1b4a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PagerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A0B8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#151538"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#A0C4E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="48"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0C4E0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#0d3a5c"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CenterGridCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#151538"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0D0D2D"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1F1F45"/>
                    <Setter Property="Foreground" Value="#2F80ED"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══ INPUT / COMBO usados en el panel de edición ══ -->
        <Style x:Key="EdInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#0d3a5c"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1a4a7a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#2F80ED"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#2F80ED"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#2F80ED"/>
                                <Setter TargetName="B" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2F80ED"/>
                                <Setter Property="Foreground" Value="#08213a"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0d3a5c"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="EdComboToggleBtn" TargetType="ToggleButton">
            <Border x:Name="Brd" Background="#0d3a5c" BorderBrush="#1a4a7a"
                    BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow" Grid.Column="1" Fill="#A0A0B8"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Brd" Property="BorderBrush" Value="#2F80ED"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#2F80ED"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Brd" Property="BorderBrush" Value="#2F80ED"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="EdComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0d3a5c"/>
            <Setter Property="BorderBrush" Value="#1a4a7a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource EdComboToggleBtn}"
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="220">
                                    <Border Background="#071d34" BorderBrush="#1a4a7a"
                                            BorderThickness="1" CornerRadius="6" Margin="0,3,0,0">
                                        <ScrollViewer Margin="0,2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EdFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#A0C4E0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- ══ Botones de acción de la barra superior y del overlay ══ -->
        <Style x:Key="HeaderActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid Margin="15,10,15,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="55"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════ HEADER ══════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Inventario de Activos Tecnológicos" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Width="280" Height="36" Background="#09274c" BorderBrush="#0d3a5c" BorderThickness="1" CornerRadius="6" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" Foreground="#A0C4E0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                            <TextBox x:Name="TxtBuscarActivo" TextChanged="TxtBuscarActivo_TextChanged" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" VerticalContentAlignment="Center" FontSize="13" CaretBrush="#2F80ED"/>
                        </Grid>
                    </Border>

                    <!-- 🔒 EDITAR (solo Administrador) -->
                    <Button x:Name="BtnEditarActivo"
                            Content="✏ Editar"
                            Width="90" Height="36"
                            Background="#151538" Foreground="#A0C4E0"
                            Style="{StaticResource HeaderActionButtonStyle}"
                            IsEnabled="False"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="BtnEditarActivo_Click"/>

                    <!-- 🔒 ELIMINAR (solo Administrador) -->
                    <Button x:Name="BtnEliminarActivo"
                            Content="🗑 Eliminar"
                            Width="100" Height="36"
                            Background="#2D1A22" Foreground="#e7133f"
                            Style="{StaticResource HeaderActionButtonStyle}"
                            IsEnabled="False"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="BtnEliminarActivo_Click"/>

                    <!-- Descargar Factura -->
                    <Button x:Name="BtnDescargarFactura"
                            Content="📄 Descargar Factura"
                            Width="150" Height="36"
                            Background="#151538" Foreground="#A0C4E0"
                            Style="{StaticResource HeaderActionButtonStyle}"
                            IsEnabled="False"
                            Margin="0,0,8,0"
                            Click="BtnDescargarFactura_Click"/>

                    <Button x:Name="BtnExportarExcel" Content="Exportar Excel" Width="120" Height="36" Background="#107C41" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnExportarExcel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ══════════════════ TABS DE FILTRO ══════════════════ -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,15">
                <Button x:Name="BtnTabTodos" Content="Todos los Activos" Style="{StaticResource TabFilterButtonStyle}" IsEnabled="False" Tag="0" Click="FilterTab_Click"/>
                <Button x:Name="BtnTabAsignados" Content="Asignados" Style="{StaticResource TabFilterButtonStyle}" Tag="0" Click="FilterTab_Click"/>
                <Button x:Name="BtnTabBodega" Content="En Bodega" Style="{StaticResource TabFilterButtonStyle}" Tag="0" Click="FilterTab_Click"/>
                <Button x:Name="BtnTabMantenimiento" Content="Mantenimiento" Style="{StaticResource TabFilterButtonStyle}" Tag="0" Click="FilterTab_Click"/>
            </StackPanel>

            <!-- ══════════════════ DATAGRID ══════════════════ -->
            <Border Grid.Row="2" Background="#09274c" CornerRadius="8" BorderBrush="#0d3a5c" BorderThickness="1" Padding="10">
                <DataGrid x:Name="DgActivos" SelectionChanged="DgActivos_SelectionChanged" Style="{StaticResource ModernDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Número de Serie" Binding="{Binding NumeroSerie}" Width="1.3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#2F80ED"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Etiqueta" Binding="{Binding EtiquetaActivo}" Width="1*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#A0A0B8"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="1*" ElementStyle="{StaticResource CenterGridCellStyle}"/>
                        <DataGridTextColumn Header="Modelo" Binding="{Binding Modelo}" Width="1.2*" ElementStyle="{StaticResource CenterGridCellStyle}"/>

                        <DataGridTextColumn Header="Estado Operativo" Binding="{Binding EstadoOperativo}" Width="1.3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="Asignado">
                                            <Setter Property="Foreground" Value="#4CD964"/>
                                        </Trigger>
                                        <Trigger Property="Text" Value="En Bodega">
                                            <Setter Property="Foreground" Value="#34AADC"/>
                                        </Trigger>
                                        <Trigger Property="Text" Value="En Mantenimiento">
                                            <Setter Property="Foreground" Value="#FF9500"/>
                                        </Trigger>
                                        <Trigger Property="Text" Value="De Baja">
                                            <Setter Property="Foreground" Value="#e7133f"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Procesador" Binding="{Binding Procesador}" Width="1.2*" ElementStyle="{StaticResource CenterGridCellStyle}"/>
                        <DataGridTextColumn Header="Memoria RAM" Binding="{Binding MemoriaRAM}" Width="1*" ElementStyle="{StaticResource CenterGridCellStyle}"/>
                        <DataGridTextColumn Header="Dirección IP" Binding="{Binding DireccionIP_Estatica}" Width="1.2*" ElementStyle="{StaticResource CenterGridCellStyle}"/>

                        <DataGridTextColumn Header="Costo (COD)" Binding="{Binding Costo, StringFormat='{}{0:C}'}" Width="1*" ElementStyle="{StaticResource CenterGridCellStyle}"/>
                        <DataGridTextColumn Header="Fecha Adquisición" Binding="{Binding FechaAdquisicion, StringFormat='{}{0:dd/MM/yyyy}'}" Width="1.2*" ElementStyle="{StaticResource CenterGridCellStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ══════════════════ PAGINADOR ══════════════════ -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <TextBlock x:Name="TxtInfoPagina" Text="Página 1 de 1" Foreground="#A0A0B8" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BtnPaginaAnterior" Style="{StaticResource PagerButtonStyle}" Click="BtnPaginaAnterior_Click">
                        <TextBlock Text="‹" FontSize="18" FontWeight="Bold" Margin="0,0,0,2"/>
                    </Button>
                    <StackPanel x:Name="PnlNumerosPagina" Orientation="Horizontal" />
                    <Button x:Name="BtnPaginaSiguiente" Style="{StaticResource PagerButtonStyle}" Click="BtnPaginaSiguiente_Click">
                        <TextBlock Text="›" FontSize="18" FontWeight="Bold" Margin="0,0,0,2"/>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="TxtContadorRegistros" Text="Mostrando 0 registros" Foreground="#A0A0B8" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════════
                 OVERLAY DE EDICIÓN DE ACTIVO (solo visible para Administrador)
                 Cubre todo el Grid.RowSpan; se activa/oculta desde el code-behind
            ══════════════════════════════════════════════════════════════ -->
            <Grid x:Name="PanelEdicionOverlay"
                  Grid.Row="0" Grid.RowSpan="4"
                  Visibility="Collapsed"
                  Panel.ZIndex="50">

                <Rectangle Fill="#113359" Opacity="0.75" MouseLeftButtonDown="OverlayEdicion_Click"/>

                <Border Background="#08213a" BorderBrush="#1a4a7a" BorderThickness="1"
                        CornerRadius="14" MaxWidth="860" MaxHeight="660"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.45" Color="Black"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="64"/>
                        </Grid.RowDefinitions>

                        <!-- Cabecera -->
                        <Border Grid.Row="0" Background="#09274c" CornerRadius="14,14,0,0" Padding="20,14">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Editar Activo Tecnológico"
                                               FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="TxtEdSubtitulo" Text="Actualiza los datos generales y las especificaciones técnicas"
                                               FontSize="11" Foreground="#A0C4E0" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="#1a2a3a" BorderThickness="0" Cursor="Hand"
                                        Click="OverlayEdicion_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                                      Fill="#A0C4E0" Width="12" Height="12" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Cuerpo con campos -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,10,16">
                            <StackPanel>

                                <TextBlock Text="INFORMACIÓN GENERAL" FontSize="10" FontWeight="Bold" Foreground="#2F80ED" Margin="6,0,0,10"/>
                                <UniformGrid Columns="2">

                                    <StackPanel Margin="6,0,14,14">
                                        <TextBlock Text="Categoría *" Style="{StaticResource EdFieldLabelStyle}"/>
                                        <ComboBox x:Name="EdCbCategoria" Style="{StaticResource EdComboStyle}"
                                                  DisplayMemberPath="Nombre" SelectedValuePath="CategoriaID"/>
                                    </StackPanel>

                                    <StackPanel Margin="6,0,14,14">
                                        <TextBlock Text="Ubicación *" Style="{StaticResource EdFieldLabelStyle}"/>
                                        <ComboBox x:Name="EdCbUbicacion" Style="{StaticResource EdComboStyle}"
                                                  DisplayMemberPath="NombreNomenclatura" SelectedValuePath="UbicacionID"/>
                                    </StackPanel>

                                    <StackPanel Margin="6,0,14,14">
                                        <TextBlock Text="Estado Operativo *" Style="{StaticResource EdFieldLabelStyle}"/>
                                        <ComboBox x:Name="EdCbEstado" Style="{StaticResource EdComboStyle}">
                                            <ComboBoxItem Content="En Bodega"/>
                                            <ComboBoxItem Content="Asignado"/>
                                            <ComboBoxItem Content="En Mantenimiento"/>
                                            <ComboBoxItem Content="De Baja"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Margin="6,0,14,14">
                                        <TextBlock Text="Proveedor" Style="{StaticResource EdFieldLabelStyle}"/>
                                        <ComboBox x:Name="EdCbProveedor" Style="{StaticResource EdComboStyle}"
                                                  DisplayMemberPath="RazonSocial" SelectedValuePath="ProveedorID"/>
                                    </StackPanel>

                                    <StackPanel Margin="6,0,14,14">
                                        <TextBlock Text="Marca" Style="{StaticResource EdFieldLabelStyle}"/>
                                        <TextBox x:Name="EdTxtMarca" Style="{StaticResource EdInputStyle}"/>
                                    </StackPanel>

                                    <StackPanel Margin="6,0,14,14">
                                        <TextBlock Text="Modelo" Style="{StaticResource EdFieldLabelStyle}"/>
                                        <TextBox x:Name="EdTxtModelo" Style="{StaticResource EdInputStyle}"/>
                                    </StackPanel>

                                    <StackPanel Margin="6,0,14,14">
                                        <TextBlock Text="Número de Serie" Style="{StaticResource EdFieldLabelStyle}"/>
                                        <TextBox x:Name="EdTxtSerie" Style="{StaticResource EdInputStyle}"/>
                                    </StackPanel>

                                    <StackPanel Margin="6,0,14,14">
                                        <TextBlock Text="Costo ($)" Style="{StaticResource EdFieldLabelStyle}"/>
                                        <TextBox x:Name="EdTxtCosto" Style="{StaticResource EdInputStyle}"/>
                                    </StackPanel>

                                    <StackPanel Margin="6,0,14,14">
                                        <TextBlock Text="Fecha de Adquisición" Style="{StaticResource EdFieldLabelStyle}"/>
                                        <DatePicker x:Name="EdDpFecha" Height="34"/>
                                    </StackPanel>

                                </UniformGrid>

                                <Separator Background="#0e3560" Margin="6,4,6,16"/>

                                <TextBlock Text="ESPECIFICACIONES DE HARDWARE" FontSize="10" FontWeight="Bold" Foreground="#2F80ED" Margin="6,0,0,10"/>
                                <UniformGrid Columns="2">

                                    <StackPanel Margin="6,0,14,14">
                                        <TextBlock Text="Procesador" Style="{StaticResource EdFieldLabelStyle}"/>
                                        <TextBox x:Name="EdTxtProcesador" Style="{StaticResource EdInputStyle}"/>
                                    </StackPanel>

                                    <StackPanel Margin="6,0,14,14">
                                        <TextBlock Text="Memoria RAM" Style="{StaticResource EdFieldLabelStyle}"/>
                                        <TextBox x:Name="EdTxtRam" Style="{StaticResource EdInputStyle}"/>
                                    </StackPanel>

                                    <StackPanel Margin="6,0,14,14">
                                        <TextBlock Text="Almacenamiento [1]" Style="{StaticResource EdFieldLabelStyle}"/>
                                        <TextBox x:Name="EdTxtDisco1" Style="{StaticResource EdInputStyle}"/>
                                    </StackPanel>

                                    <StackPanel Margin="6,0,14,14">
                                        <TextBlock Text="Almacenamiento [2]" Style="{StaticResource EdFieldLabelStyle}"/>
                                        <TextBox x:Name="EdTxtDisco2" Style="{StaticResource EdInputStyle}"/>
                                    </StackPanel>

                                    <StackPanel Margin="6,0,14,14">
                                        <TextBlock Text="Tarjeta Gráfica" Style="{StaticResource EdFieldLabelStyle}"/>
                                        <TextBox x:Name="EdTxtGrafica" Style="{StaticResource EdInputStyle}"/>
                                    </StackPanel>

                                    <StackPanel Margin="6,0,14,14">
                                        <TextBlock Text="Sistema Operativo" Style="{StaticResource EdFieldLabelStyle}"/>
                                        <TextBox x:Name="EdTxtSo" Style="{StaticResource EdInputStyle}"/>
                                    </StackPanel>

                                    <StackPanel Margin="6,0,14,14">
                                        <TextBlock Text="Dirección MAC" Style="{StaticResource EdFieldLabelStyle}"/>
                                        <TextBox x:Name="EdTxtMac" Style="{StaticResource EdInputStyle}"/>
                                    </StackPanel>

                                    <StackPanel Margin="6,0,14,14">
                                        <TextBlock Text="Dirección IP" Style="{StaticResource EdFieldLabelStyle}"/>
                                        <TextBox x:Name="EdTxtIp" Style="{StaticResource EdInputStyle}"/>
                                    </StackPanel>

                                    <StackPanel Margin="6,0,14,14" Grid.ColumnSpan="2">
                                        <TextBlock Text="Resolución de Pantalla" Style="{StaticResource EdFieldLabelStyle}"/>
                                        <TextBox x:Name="EdTxtResolucion" Style="{StaticResource EdInputStyle}"/>
                                    </StackPanel>

                                </UniformGrid>

                                <Separator Background="#0e3560" Margin="6,4,6,16"/>

                                <TextBlock Text="FACTURA DE COMPRA (PDF)" FontSize="10" FontWeight="Bold" Foreground="#2F80ED" Margin="6,0,0,10"/>
                                <Grid Margin="6,0,14,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#0d3a5c" BorderBrush="#1a4a7a" BorderThickness="1" CornerRadius="6,0,0,6" Height="34">
                                        <TextBlock x:Name="EdTxtNombreFactura"
                                                   Text="Ningún archivo nuevo seleccionado"
                                                   Foreground="#A0A0B8" FontSize="12"
                                                   VerticalAlignment="Center" Margin="10,0"/>
                                    </Border>

                                    <Button x:Name="EdBtnSeleccionarPdf" Grid.Column="1"
                                            Content="Reemplazar PDF"
                                            Height="34" Padding="12,0"
                                            Background="#2F80ED" Foreground="#060621"
                                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                            Click="EdBtnSeleccionarPdf_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button x:Name="EdBtnVerPdf" Grid.Column="2"
                                            Content="Ver PDF"
                                            Height="34" Padding="12,0"
                                            Background="#151538" Foreground="#A0C4E0"
                                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                            IsEnabled="False"
                                            Click="EdBtnVerPdf_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="0,6,6,0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Pie -->
                        <Border Grid.Row="2" Background="#09274c" CornerRadius="0,0,14,14"
                                BorderBrush="#0d3a5c" BorderThickness="0,1,0,0" Padding="20,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Cancelar" Width="110" Height="38"
                                        Background="#151538" Foreground="#A0A0B8"
                                        BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"
                                        Click="OverlayEdicion_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="BtnGuardarEdicion" Content="Guardar Cambios" Width="170" Height="38"
                                        Background="#2F80ED" Foreground="#08213a" FontWeight="SemiBold"
                                        BorderThickness="0" Cursor="Hand" Click="BtnGuardarEdicion_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
