<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\a1.jpg" />
    <None Remove="Assets\a2.png" />
    <None Remove="Assets\a3.png" />
    <None Remove="Assets\idit_logo.png" />
    <None Remove="Assets\image_login_1.png" />
    <None Remove="Assets\log.png" />
    <None Remove="Assets\LoginIM.png" />
    <None Remove="Assets\MapaColombia.html" />
    <None Remove="Assets\Recurso 5.png" />
    <None Remove="Assets\Recurso-1.ico" />
    <None Remove="init.sql" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="init.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dominio\Dominio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\idit_logo.png" />
    <Resource Include="Assets\log.png" />
    <Resource Include="Assets\LoginIM.png" />
    <Resource Include="Assets\Recurso 5.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Recurso-1.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
